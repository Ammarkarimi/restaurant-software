# Database (PostgreSQL)
# Local Docker: postgresql://restaurant:restaurant@localhost:5432/restaurant_manager?schema=public
# Neon/Supabase/Vercel Postgres: use the connection string from your provider
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_manager?schema=public"

# Auth — required in production (use a long random string, e.g. openssl rand -base64 32)
JWT_SECRET="change-me-in-production"

# File storage for restaurant logos
# local = filesystem (default for development)
# blob = Vercel Blob (auto-selected when BLOB_READ_WRITE_TOKEN is set)
STORAGE_DRIVER="local"

# Local upload directory (only used when STORAGE_DRIVER=local)
UPLOAD_DIR="./uploads"

# Vercel Blob — required for logo uploads on Vercel (its disk is not permanent)
# Create at: Vercel Dashboard → Storage → Blob → Connect to project
BLOB_READ_WRITE_TOKEN=""

# Node environment (set automatically on most hosts)
NODE_ENV="development"

# Show the demo sign-in accounts on the login page in production (for demo sites only)
NEXT_PUBLIC_DEMO_MODE="false"

# Software provider's owner panel at /platform (create restaurants, track monthly payments).
# This is the only owner-panel account. /platform stays locked until both are set.
# The password must be at least 10 characters.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
# Time zone that decides "this month" for subscriptions (default Asia/Kolkata)
# PLATFORM_TIMEZONE="Asia/Kolkata"

# Landing page "Ask for a free demo": every enquiry is saved in /platform → Enquiries and,
# when both of these are set, also emailed. Get a free API key at https://resend.com
# (sign up with the same email as ENQUIRY_EMAIL_TO: without your own domain, Resend only
# delivers to the email of the account).
ENQUIRY_EMAIL_TO=""
RESEND_API_KEY=""
# Sender, once you have verified your own domain in Resend (default: onboarding@resend.dev)
# EMAIL_FROM="Restaurant Manager <hello@yourdomain.com>"

# The daily job (vercel.json → /api/cron/daily) sends yesterday's report to owners who did not
# close the day. Vercel calls it with this secret.
CRON_SECRET=""
# Owner alerts and daily reports on WhatsApp (Meta WhatsApp Cloud API, approved Utility templates:
# owner_alert = "Alert from {{1}}: {{2}}", daily_report = "Daily report for {{1}}, {{2}}: {{3}}")
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ALERT_TEMPLATE="owner_alert"
# WHATSAPP_REPORT_TEMPLATE="daily_report"
# WHATSAPP_TEMPLATE_LANG="en"
# Menu → Import → Menu photo: reads dishes off photos of a printed menu (Anthropic API)
ANTHROPIC_API_KEY=""
