generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A restaurant that pays to use the software. Every other record belongs to exactly one
// restaurant, and restaurants never see each other's data.
model Restaurant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  status               String                @default("active") // active, suspended
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  city                 String?
  monthlyFee           Float                 @default(0)
  billingStart         String // first month that is charged, "YYYY-MM"
  notes                String?
  orderSeq             Int                   @default(0) // last order number handed out
  billSeq              Int                   @default(0) // last bill number handed out
  kotSeq               Int                   @default(0) // last kitchen ticket number handed out
  purchaseSeq          Int                   @default(0) // last purchase order number handed out
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  staff                Staff[]
  settings             RestaurantSettings?
  tables               DiningTable[]
  categories           MenuCategory[]
  menuItems            MenuItem[]
  orders               Order[]
  orderItems           OrderItem[]
  payments             Payment[]
  activities           ActivityLog[]
  subscriptionPayments SubscriptionPayment[]
  customers            Customer[]
  expenses             Expense[]
  dayCloses            DayClose[]
  stockItems           StockItem[]
  stockEntries         StockEntry[]
  recipeLines          RecipeLine[]
  outletAccess         OutletAccess[]
  addonGroups          AddonGroup[]
  priceLists           PriceList[]
  offers               Offer[]
  customerTxns         CustomerTxn[]
  reservations         Reservation[]
  suppliers            Supplier[]
  purchases            Purchase[]
  feedback             Feedback[]
  campaigns            Campaign[]
  attendance           Attendance[]
}

// Money a restaurant paid the software provider for its monthly subscription.
model SubscriptionPayment {
  id           String     @id @default(cuid())
  restaurantId String
  month        String // the month this payment is for, "YYYY-MM"
  amount       Float
  clearsMonth  Boolean    @default(true) // false = part payment, the month is still due
  method       String     @default("upi") // cash, upi, bank_transfer, card, cheque, other
  reference    String?
  notes        String?
  paidOn       DateTime   @db.Date
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, month])
}

model Staff {
  id           String         @id @default(cuid())
  restaurantId String
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("staff") // admin = owner / manager, staff = cashier / captain, kitchen = kitchen screen only
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  permissions  String         @default("{}") // JSON rights for cashiers / captains, see src/lib/permissions.ts
  activities   ActivityLog[]
  outlets      OutletAccess[]
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// An owner who runs more than one restaurant: their sign-in can also manage these outlets.
model OutletAccess {
  id           String     @id @default(cuid())
  staffId      String
  restaurantId String
  createdAt    DateTime   @default(now())
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([staffId, restaurantId])
  @@index([restaurantId])
}

// One row per restaurant holding its profile, tax rules and bill design.
model RestaurantSettings {
  id                    String     @id @default(cuid())
  restaurantId          String     @unique
  restaurantName        String     @default("My Restaurant")
  legalName             String? // registered business name, if different
  address               String?
  city                  String?
  phone                 String?
  email                 String?
  gstin                 String?
  fssai                 String? // food licence number, printed on bills in India
  currency              String     @default("INR")
  timezone              String     @default("Asia/Kolkata")
  taxMode               String     @default("gst") // gst (CGST + SGST), simple (one tax line), none
  taxName               String     @default("Tax") // label used when taxMode = simple, e.g. VAT
  defaultTaxRate        Float      @default(5)
  pricesIncludeTax      Boolean    @default(false)
  serviceChargePercent  Float      @default(0)
  packingCharge         Float      @default(0) // added to every takeaway and delivery order
  deliveryCharge        Float      @default(0) // added to every delivery order
  roundOff              Boolean    @default(true)
  billPrefix            String     @default("")
  upiId                 String? // printed as a QR code on the bill so guests can pay
  loyaltyEnabled        Boolean    @default(false)
  loyaltyEarnPercent    Float      @default(5) // points earned = this % of the bill; 1 point = 1 rupee off
  loyaltyMinRedeem      Float      @default(100) // points a guest needs before they can use them
  qrMenuEnabled         Boolean    @default(true) // guests can open the menu from a QR code
  qrOrderingEnabled     Boolean    @default(false) // guests can order from the table QR code; staff confirm
  kitchenStations       String     @default("[]") // JSON names of cooking stations, e.g. ["Tandoor", "Bar"]; each prints its own kitchen ticket
  deliveryRiders        String     @default("[]") // JSON [{ "name": "Raju", "phone": "98…" }]
  appCommission         String     @default("{}") // JSON % the apps keep, e.g. { "zomato": 25, "swiggy": 22 }, for the payout report
  onlineOrderingEnabled Boolean    @default(false) // guests can order takeaway (and delivery) from the restaurant's own link
  onlineDeliveryEnabled Boolean    @default(false)
  onlineMinOrder        Float      @default(0)
  onlineBookingEnabled  Boolean    @default(false) // guests can ask for a table booking from the restaurant's link
  googleReviewUrl       String? // guests who rate their visit 4 or 5 stars are asked to review here
  logoPath              String?
  billTemplate          String     @default("{}") // JSON, see src/lib/bill-template.ts
  updatedAt             DateTime   @updatedAt
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model DiningTable {
  id           String        @id @default(cuid())
  restaurantId String
  name         String // "T1", "Garden 4"
  area         String        @default("Main hall")
  seats        Int           @default(4)
  sortOrder    Int           @default(0)
  active       Boolean       @default(true)
  qrToken      String        @unique @default(cuid()) // in the table's QR code, so guests can order for this table
  callType     String? // a guest pressed "Call waiter" (waiter) or "Ask for the bill" (bill)
  callAt       DateTime?
  createdAt    DateTime      @default(now())
  reservations Reservation[]
  orders       Order[]       @relation("TableOrders")
  activeOrder  Order?        @relation("ActiveTableOrder")
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  station      String? // the kitchen station that cooks it; null = the main kitchen
  createdAt    DateTime   @default(now())
  items        MenuItem[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model MenuItem {
  id            String       @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  shortCode     String? // typed at the counter for quick search, e.g. "PBM"
  description   String?
  price         Float // used when the item has no portions
  variants      String       @default("[]") // JSON [{ "name": "Half", "price": 180 }]
  foodType      String       @default("veg") // veg, non_veg, egg
  taxRate       Float? // null = the restaurant's default rate
  available     Boolean      @default(true) // false = sold out today
  addonGroupIds String       @default("[]") // JSON ids of the add-on groups offered with it, in order
  imagePath     String? // photo shown on the QR menu
  showOnline    Boolean      @default(true) // false = only staff see it, not the QR / online menu
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  category      MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  recipeLines   RecipeLine[]
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, categoryId])
}

model Order {
  id                   String       @id @default(cuid())
  restaurantId         String
  number               Int // counts up per restaurant
  type                 String       @default("dine_in") // dine_in, takeaway, delivery
  source               String       @default("counter") // counter, phone, zomato, swiggy, app, qr
  sourceRef            String? // the order id on Zomato / Swiggy / the other app
  status               String       @default("open") // open, billed, settled, cancelled
  tableId              String?
  // Set to tableId while the order is running and cleared when it is paid or cancelled,
  // so the database itself refuses two running orders on one table.
  activeTableId        String?      @unique
  customerId           String?
  customerName         String?
  customerPhone        String?
  customerAddress      String?
  guests               Int          @default(0)
  notes                String?
  discountType         String       @default("percent") // percent, amount
  discountValue        Float        @default(0)
  discountReason       String?
  discountMax          Float? // most a percent discount may take off (from an offer)
  offerId              String? // the offer the discount came from
  complimentary        Boolean      @default(false) // on the house: nothing to pay, kept apart in reports
  scheduledFor         DateTime? // pickup / delivery time asked for (online and advance orders)
  riderName            String? // who takes a delivery order out
  deliveryStatus       String? // out, delivered
  outAt                DateTime?
  deliveredAt          DateTime?
  pointsRedeemed       Float        @default(0) // loyalty points used on this bill
  pointsEarned         Float        @default(0) // loyalty points given when it was paid
  // Tax rules copied from settings when the order is opened, so later changes
  // to settings never alter this bill.
  taxMode              String       @default("gst")
  taxName              String       @default("Tax")
  pricesIncludeTax     Boolean      @default(false)
  serviceChargePercent Float        @default(0)
  roundOff             Boolean      @default(true)
  packingCharge        Float        @default(0)
  deliveryCharge       Float        @default(0)
  chargeTaxRate        Float        @default(0) // tax rate on packing and delivery charges
  billNumber           String?
  // Totals saved when the bill is printed and again when it is paid.
  subtotal             Float        @default(0)
  discountAmount       Float        @default(0)
  serviceCharge        Float        @default(0)
  chargesAmount        Float        @default(0)
  taxAmount            Float        @default(0)
  roundOffAmount       Float        @default(0)
  total                Float        @default(0)
  businessDate         String? // "YYYY-MM-DD" in the restaurant's time zone, set when paid
  cancelReason         String?
  createdById          String?
  createdByName        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  billedAt             DateTime?
  settledAt            DateTime?
  cancelledAt          DateTime?
  table                DiningTable? @relation("TableOrders", fields: [tableId], references: [id], onDelete: SetNull)
  activeTable          DiningTable? @relation("ActiveTableOrder", fields: [activeTableId], references: [id], onDelete: SetNull)
  customer             Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  restaurant           Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, number])
  @@unique([restaurantId, billNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id            String     @id @default(cuid())
  restaurantId  String
  orderId       String
  menuItemId    String?
  name          String // copied from the menu so later menu edits never change old bills
  variant       String?
  categoryName  String?
  foodType      String     @default("veg")
  price         Float // unit price
  quantity      Int        @default(1)
  taxRate       Float      @default(0)
  note          String? // "less spicy", "no onion"
  addons        String     @default("[]") // JSON [{ "group": "Toppings", "name": "Extra cheese", "price": 40 }]; included in price
  station       String? // kitchen station the ticket goes to; null = the main kitchen
  byGuest       Boolean    @default(false) // ordered by the guest from the table QR code
  kotNumber     Int? // null = not sent to the kitchen yet
  sentAt        DateTime?
  kitchenStatus String     @default("new") // on the kitchen screen: new (cooking), ready, served
  readyAt       DateTime?
  status        String     @default("active") // active, cancelled
  cancelReason  String?
  createdAt     DateTime   @default(now())
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, orderId])
}

model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  orderId      String
  amount       Float
  method       String // cash, upi, card, other
  reference    String?
  receivedBy   String?
  paidAt       DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, paidAt])
}

// A guest the restaurant knows by phone number: saved automatically from paid bills.
model Customer {
  id           String        @id @default(cuid())
  restaurantId String
  phone        String // digits only, without country code for Indian mobiles
  name         String?
  address      String?
  email        String?
  birthday     String? // "YYYY-MM-DD"
  notes        String?
  points       Float         @default(0) // loyalty points balance
  balance      Float         @default(0) // money on their account: more than 0 = paid in advance (wallet), less than 0 = they owe
  creditLimit  Float? // most they may owe; null = no limit
  txns         CustomerTxn[]
  visits       Int           @default(0)
  totalSpent   Float         @default(0)
  lastVisitAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastVisitAt])
}

// Money paid out: vegetables, gas, salary advance… "cash" means it came out of the till.
model Expense {
  id            String     @id @default(cuid())
  restaurantId  String
  date          String // business day, "YYYY-MM-DD"
  category      String
  amount        Float
  method        String     @default("cash") // cash, upi, card, bank
  paidTo        String?
  notes         String?
  createdById   String?
  createdByName String
  createdAt     DateTime   @default(now())
  supplierId    String? // a payment to a supplier
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
}

// End of the day: the cash in the drawer counted against what it should be.
model DayClose {
  id           String     @id @default(cuid())
  restaurantId String
  date         String // business day, "YYYY-MM-DD"
  openingCash  Float // in the drawer when the day started
  cashSales    Float
  cashExpenses Float
  expectedCash Float // opening + cash sales − cash expenses
  countedCash  Float
  difference   Float // counted − expected; negative = short
  cashLeft     Float // left in the drawer for tomorrow
  sales        Float // all payment methods
  bills        Int
  summary      String     @default("{}") // JSON: payments by method, expenses by category
  notes        String?
  closedById   String?
  closedByName String
  closedAt     DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
}

// Something the kitchen keeps in stock: paneer, oil, milk, chicken, cups…
model StockItem {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  unit         String       @default("kg") // kg, g, L, ml, pcs, dozen, pack, box, bottle
  quantity     Float        @default(0) // in stock now
  lowAt        Float? // show a warning when stock falls to this level
  costPerUnit  Float        @default(0) // last purchase price, for the stock value
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  entries      StockEntry[]
  recipeLines  RecipeLine[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
}

// Every change to stock: purchases, what bills used, wastage and stock counts.
model StockEntry {
  id            String     @id @default(cuid())
  restaurantId  String
  stockItemId   String
  type          String // purchase, used, returned, wastage, count
  quantity      Float // + adds stock, − takes it out
  balance       Float // in stock after this entry
  cost          Float? // money paid, for purchases
  supplier      String?
  note          String?
  orderId       String? // the bill that used it
  date          String // business day, "YYYY-MM-DD"
  createdByName String
  createdAt     DateTime   @default(now())
  stockItem     StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, stockItemId, createdAt])
  @@index([restaurantId, date])
  @@index([restaurantId, orderId])
}

// What one dish uses from stock, so paid bills take it out automatically.
model RecipeLine {
  id           String     @id @default(cuid())
  restaurantId String
  menuItemId   String
  variant      String? // null = every portion; otherwise only this portion (e.g. "Full")
  stockItemId  String
  quantity     Float // per one dish, in the stock item's unit
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem    StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, menuItemId])
}

model ActivityLog {
  id           String     @id @default(cuid())
  restaurantId String
  staffId      String?
  staffName    String
  action       String
  details      String?
  createdAt    DateTime   @default(now())
  staff        Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

// Someone asked for a demo on the public landing page. Seen by the software provider in /platform.
model Lead {
  id             String   @id @default(cuid())
  name           String
  restaurantName String?
  phone          String
  city           String?
  message        String?
  status         String   @default("new") // new, contacted, won, lost
  notes          String? // the provider's own notes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

// A group of extras offered with dishes: "Toppings" (pick any), "Choose your drink" (pick 1)…
model AddonGroup {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  minSelect    Int        @default(0) // 1 or more = the guest must choose
  maxSelect    Int        @default(0) // 0 = no limit
  options      String     @default("[]") // JSON [{ "name": "Extra cheese", "price": 40 }]
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Different prices for an area (AC hall), an order type, an app (Zomato / Swiggy) or a time (happy hours).
model PriceList {
  id            String     @id @default(cuid())
  restaurantId  String
  name          String
  active        Boolean    @default(true)
  adjustPercent Float      @default(0) // +10 = 10% dearer, -20 = 20% off; dishes with their own price below ignore it
  roundTo       Float      @default(1) // round changed prices to this (1, 5, 10)
  areas         String     @default("[]") // JSON table areas; empty = any
  orderTypes    String     @default("[]") // JSON dine_in / takeaway / delivery; empty = any
  sources       String     @default("[]") // JSON counter / zomato / swiggy…; empty = any
  days          String     @default("[]") // JSON 0 (Sunday) … 6; empty = every day
  startTime     String? // "17:00"; with endTime, only between these times
  endTime       String?
  categoryIds   String     @default("[]") // JSON menu categories it changes; empty = the whole menu
  overrides     String     @default("{}") // JSON { menuItemId: { "price": 300, "variants": { "Full": 420 } } }
  sortOrder     Int        @default(0) // the first matching list wins
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// A saved discount: "10% off above ₹1000", "WELCOME50" coupon, weekday lunch offer…
model Offer {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  code         String? // coupon code guests say or show; null = staff pick it from the list
  type         String     @default("percent") // percent, amount
  value        Float
  maxDiscount  Float? // most a percent offer takes off
  minBill      Float      @default(0) // items total needed
  orderTypes   String     @default("[]") // JSON; empty = any
  days         String     @default("[]") // JSON 0 (Sunday) … 6; empty = every day
  startTime    String?
  endTime      String?
  validFrom    String? // "YYYY-MM-DD"
  validTo      String?
  active       Boolean    @default(true)
  timesUsed    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Money on a customer's account: bills put on account (pay later), money received, wallet top-ups.
model CustomerTxn {
  id            String     @id @default(cuid())
  restaurantId  String
  customerId    String
  type          String // bill (put on account), received (money paid in), refund, adjust
  amount        Float // + adds to their balance, − takes from it
  balance       Float // their balance after this entry
  method        String? // how money was received: cash, upi, card, bank
  orderId       String?
  billNumber    String?
  note          String?
  date          String // business day, "YYYY-MM-DD"
  createdByName String
  createdAt     DateTime   @default(now())
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, customerId, createdAt])
  @@index([restaurantId, date])
}

// A table booked for later, by phone, walk-in or the restaurant's booking link.
model Reservation {
  id            String       @id @default(cuid())
  restaurantId  String
  name          String
  phone         String
  guests        Int          @default(2)
  date          String // "YYYY-MM-DD"
  time          String // "19:30"
  tableId       String?
  status        String       @default("booked") // requested (from the link, to confirm), booked, seated, cancelled, no_show
  source        String       @default("phone") // phone, walk_in, online
  occasion      String? // birthday, anniversary…
  notes         String?
  orderId       String? // the order opened when they were seated
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  table         DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
}

// Someone the restaurant buys from: vegetables, meat, dairy, packaging…
model Supplier {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  gstin        String?
  address      String?
  notes        String?
  balance      Float      @default(0) // what the restaurant owes them
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]
  payments     Expense[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
}

// A purchase order sent to a supplier; when the goods arrive it is received into stock.
model Purchase {
  id            String     @id @default(cuid())
  restaurantId  String
  number        Int // counts up per restaurant
  supplierId    String?
  supplierName  String
  status        String     @default("ordered") // ordered, received, cancelled
  invoiceNo     String? // the supplier's bill number
  orderedOn     String // "YYYY-MM-DD"
  receivedOn    String?
  lines         String     @default("[]") // JSON [{ "stockItemId", "name", "unit", "quantity", "rate" }]
  total         Float      @default(0)
  notes         String?
  createdByName String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

// What a guest thought of their visit, from the link on their e-bill.
model Feedback {
  id           String     @id @default(cuid())
  restaurantId String
  orderId      String     @unique
  customerId   String?
  name         String?
  phone        String?
  rating       Int // 1 to 5
  food         Int?
  service      Int?
  ambience     Int?
  comment      String?
  followedUp   Boolean    @default(false) // the owner called back about a low rating
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

// A WhatsApp message to a group of customers (birthdays, not seen lately…), sent one tap at a time.
model Campaign {
  id            String     @id @default(cuid())
  restaurantId  String
  name          String
  segment       String // all, birthday, inactive, regulars, top, owes
  message       String
  recipients    String     @default("[]") // JSON [{ "customerId", "name", "phone", "sentAt" }]
  createdByName String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

// A staff member's working day: when they started and finished.
model Attendance {
  id           String     @id @default(cuid())
  restaurantId String
  staffId      String
  staffName    String
  date         String // business day, "YYYY-MM-DD"
  inAt         DateTime
  outAt        DateTime?
  note         String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@index([restaurantId, staffId, date])
}
